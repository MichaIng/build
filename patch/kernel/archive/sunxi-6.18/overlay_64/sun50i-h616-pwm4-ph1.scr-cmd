setenv bootargs_new ""
for arg in ${bootargs}; do
	if test "${arg}" = "console=ttyS0,115200"; then
		echo "Warning: Disabling ttyS0 console due to enabled pwm4-ph1 overlay (PH0/PH1 are UART0)"
	else
		setenv bootargs_new "${bootargs_new} ${arg}"
	fi
done
setenv bootargs "${bootargs_new}"
env delete bootargs_new
