From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MichaIng <micha@dietpi.com>
Date: Wed, 11 Nov 2026 22:55:00 +0100
Subject: arm64: dts: allwinner: t527-orangepi-4a: set heartbeat trigger for
 green LED

The green status LED is off by default, so there is no indication that the
kernel has been loaded. Use the heartbeat trigger by default.

Signed-off-by: MichaIng <micha@dietpi.com>
---
 arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -38,6 +38,7 @@ led {
 			function = LED_FUNCTION_STATUS;
 			color = <LED_COLOR_ID_GREEN>;
 			gpios = <&pio 3 20 GPIO_ACTIVE_HIGH>; /* PD20 */
+			linux,default-trigger = "heartbeat";
 		};
 	};
 
-- 
Armbian

